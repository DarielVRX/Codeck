<?xml version="1.0" encoding="utf-8"?>
<!--
    Pestaña por color elegido por el usuario. Inactiva: angosta, solo extensión
    sin punto ("py", "js"). Activa: se ensancha y agrega el nombre del archivo.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tabRoot"
    android:layout_width="wrap_content"
    android:layout_height="28dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/bg_tab"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:minWidth="30dp">

    <TextView
        android:id="@+id/tabExt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="py"
        android:textColor="#CC0D0D10"
        android:textSize="9sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tabName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:fontFamily="sans-serif"
        android:text="main"
        android:textColor="#D90D0D10"
        android:textSize="10sp"
        android:visibility="gone"
        android:maxWidth="90dp"
        android:ellipsize="end"
        android:singleLine="true" />

</LinearLayout>
