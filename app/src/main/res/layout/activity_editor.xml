<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout raíz. El inset del teclado (IME) se aplica manualmente como padding
    inferior desde EditorActivity.setupKeyboardInsetHandling(), en vez de
    depender de windowSoftInputMode="adjustResize" (poco confiable en Android
    11+ con ventanas edge-to-edge). Gracias a ese padding, controlBar —el
    último elemento visible de este LinearLayout— queda siempre empujado
    justo arriba del teclado real, nunca debajo de él.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Tabbar + acciones (se oculta en landscape mientras el teclado está activo).
         El botón de rotar pantalla vive en la barra de controles (ver más abajo),
         no aquí: aquí competía por espacio con las pestañas, que cambian de ancho. -->
    <LinearLayout
        android:id="@+id/tabBarRow"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/bg_elevated"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tabRecycler"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/runButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_run_button"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/action_run"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/saveButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="💾"
            android:textSize="18sp"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/folderButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="📁"
            android:textSize="18sp"
            android:layout_marginStart="2dp" />

    </LinearLayout>

    <!-- Ruta del archivo activo (se oculta en landscape mientras el teclado está activo) -->
    <TextView
        android:id="@+id/pathBar"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:background="@color/bg"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:textColor="@color/text_dim"
        android:textSize="11sp"
        android:text=""
        android:visibility="gone" />

    <!-- Contenedor del explorador de archivos. Es la pantalla inicial de la app
         (no una pestaña "sin título"): se muestra al abrir si no hay archivos
         abiertos, y también al tocar 📁 con archivos ya abiertos. -->
    <FrameLayout
        android:id="@+id/explorerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="visible">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/explorerRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Botón grande para crear un archivo nuevo: es la acción principal de
             la pantalla inicial, por eso es grande y no un ícono chico más. -->
        <TextView
            android:id="@+id/createFileButtonBig"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_run_button"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="＋ Nuevo archivo"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Contenedor del editor activo -->
    <FrameLayout
        android:id="@+id/editorContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <!-- Panel de consola de ejecución (oculto hasta el primer Run) -->
    <FrameLayout
        android:id="@+id/consoleContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <!-- Barra de controles: SIEMPRE debajo del teclado del sistema. Oculta
         mientras se está en el explorador (no hay editor activo que controlar). -->
    <com.codemobile.ui.ControlBarView
        android:id="@+id/controlBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>
