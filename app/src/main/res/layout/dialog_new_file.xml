<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/bg_elevated">

    <EditText
        android:id="@+id/editFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_filename"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_dim"
        android:inputType="text"
        android:singleLine="true" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/label_choose_color"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <!-- columnCount se fija dinámicamente en código según el ancho real de
         pantalla (ver EditorActivity.showNewFileDialog), para que los círculos
         de color nunca excedan el margen horizontal en pantallas angostas. -->
    <GridLayout
        android:id="@+id/colorGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

</LinearLayout>
