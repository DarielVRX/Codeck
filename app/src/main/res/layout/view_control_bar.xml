<?xml version="1.0" encoding="utf-8"?>
<!--
    Barra de controles fija: SIEMPRE se ubica debajo del teclado del sistema,
    nunca encima (ver EditorActivity.setupKeyboardInsetHandling). Contiene:
    grupos de símbolos expandibles, celda de cierre pendiente (pila de
    autocompletado), flechas de dirección y el toggle Select.

    Los controles usan una altura mínima de 44dp (tamaño táctil recomendado),
    y la fila principal se puede desplazar horizontalmente si no entra todo en
    pantallas angostas, en vez de comprimir cada botón para que todo quepa.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/expandPanel"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/bg_panel"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/expandPanelSymbols"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@color/bg_elevated"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/symGroupBrackets"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_symbol_group"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="{ } ▾"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/symGroupQuotes"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_symbol_group"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="&quot; &#39; ▾"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/symGroupPunctuation"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_symbol_group"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="= ; ▾"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <!-- Celda dedicada de cierre pendiente: muestra el tope de la pila por archivo -->
            <TextView
                android:id="@+id/pendingCloserCell"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_symbol_group"
                android:fontFamily="monospace"
                android:gravity="center"
                android:minWidth="44dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text=""
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="invisible" />

            <!-- Tab real: inserta \t (tabulación normal), independiente de la
                 autoindentación automática. Útil para indentar manualmente o
                 cuando la heurística de autoindent no acierta el nivel. -->
            <TextView
                android:id="@+id/tabKey"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_symbol_group"
                android:fontFamily="monospace"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="⇥ Tab"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="10dp">

                <TextView
                    android:id="@+id/arrowUp"
                    android:layout_width="40dp"
                    android:layout_height="20dp"
                    android:gravity="center"
                    android:text="↑"
                    android:textColor="@color/text_dim"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/arrowLeft"
                        android:layout_width="40dp"
                        android:layout_height="20dp"
                        android:gravity="center"
                        android:text="←"
                        android:textColor="@color/text_dim"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/arrowDown"
                        android:layout_width="40dp"
                        android:layout_height="20dp"
                        android:gravity="center"
                        android:text="↓"
                        android:textColor="@color/text_dim"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/arrowRight"
                        android:layout_width="40dp"
                        android:layout_height="20dp"
                        android:gravity="center"
                        android:text="→"
                        android:textColor="@color/text_dim"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/selectToggle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_pill_outline"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/action_select"
                android:textColor="@color/accent"
                android:textSize="13sp" />

            <!-- Rotar pantalla: vive aquí (barra fija) en vez de en la tabbar,
                 donde competía por espacio con las pestañas de ancho variable. -->
            <TextView
                android:id="@+id/rotateButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_symbol_group"
                android:gravity="center"
                android:text="⤾"
                android:textColor="@color/text_dim"
                android:textSize="18sp" />

        </LinearLayout>
    </HorizontalScrollView>
</merge>
