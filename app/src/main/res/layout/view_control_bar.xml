<?xml version="1.0" encoding="utf-8"?>
<!--
    Barra de controles fija: SIEMPRE se ubica debajo del teclado del sistema,
    nunca encima (ver EditorActivity.setupKeyboardInsetHandling). Contiene:
    grupos de símbolos expandibles, celda de cierre pendiente (pila de
    autocompletado), flechas de dirección y el toggle Select.

    Los controles usan una altura mínima de 44dp (tamaño táctil recomendado),
    y la fila principal se puede desplazar horizontalmente si no entra todo en
    pantallas angostas, en vez de comprimir cada botón para que todo quepa.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/expandPanel"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/bg_panel"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/expandPanelSymbols"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>
    </LinearLayout>

    <!-- Fila fija, SIN scroll: cada celda usa layout_weight para repartirse el
         ancho disponible y nunca desbordar en portrait. Los textos se limitan
         a 1 carácter (o símbolo) para que quepan incluso angostas. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/bg_elevated"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="3dp"
        android:paddingEnd="3dp">

        <TextView
            android:id="@+id/symGroupBrackets"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_symbol_group"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="{"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/symGroupQuotes"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_symbol_group"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="&quot;"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/symGroupPunctuation"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_symbol_group"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="="
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- Celda dedicada de cierre pendiente: muestra el tope de la pila por archivo -->
        <TextView
            android:id="@+id/pendingCloserCell"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_symbol_group"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text=""
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="invisible" />

        <!-- Tab real: inserta \t (tabulación normal), independiente de la
             autoindentación automática. Útil para indentar manualmente o
             cuando la heurística de autoindent no acierta el nivel. -->
        <TextView
            android:id="@+id/tabKey"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_symbol_group"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="⇥"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/arrowLeft"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:background="@drawable/bg_symbol_group"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="1dp">

            <TextView
                android:id="@+id/arrowUp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="↑"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/arrowDown"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="↓"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/arrowRight"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_symbol_group"
            android:gravity="center"
            android:text="→"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/selectToggle"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/bg_pill_outline"
            android:gravity="center"
            android:text="S"
            android:textColor="@color/accent"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Rotar pantalla: vive aquí (barra fija) en vez de en la tabbar,
             donde competía por espacio con las pestañas de ancho variable. -->
        <TextView
            android:id="@+id/rotateButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:background="@drawable/bg_symbol_group"
            android:gravity="center"
            android:text="⤾"
            android:textColor="@color/text_dim"
            android:textSize="16sp" />

    </LinearLayout>
</merge>
